# OpenAI API Key (required for chat)
OPENAI_API_KEY=sk-...

# Alchemy API Key (required for multi-chain RPC)
# Get your key at: https://dashboard.alchemy.com/
# Used for: Sepolia, Base Sepolia
ALCHEMY_API_KEY=your_alchemy_api_key

# Agent private key for auto-executing ready payrolls
# If not set, cron will only check but not execute
AGENT_PRIVATE_KEY=0x...

# Server port (optional, defaults to 3001)
PORT=3001

# Cron interval in milliseconds (optional, defaults to 60000 = 1 minute)
CRON_INTERVAL=60000

# Custom RPC URL (optional, overrides Alchemy for primary chain)
# RPC_URL=https://custom-rpc.example.com

# MongoDB connection
MONGO_URI=mongodb://localhost:27017/arc_payroll_db

# Yellow Network Configuration (Nitrolite SDK)
# WebSocket endpoint for ClearNode
YELLOW_WS_URL=wss://clearnet-sandbox.yellow.com/ws
# Custody contract address (Sepolia)
YELLOW_CUSTODY_ADDRESS=0x019B65A265EB3363822f2752141b3dF16131b262
# Adjudicator contract address (Sepolia)
YELLOW_ADJUDICATOR_ADDRESS=0x7c7ccbc98469190849BCC6c926307794fDfB11F2
# Token address for state channels (ytest.usd on Sepolia)
YELLOW_TOKEN_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238