# OpenAI API Key
OPENAI_API_KEY=sk-...

# RPC URL for Sepolia (optional, uses default if not set)
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Server port (optional, defaults to 3001)
PORT=3001

# Cron interval in milliseconds (optional, defaults to 60000 = 1 minute)
CRON_INTERVAL=60000

# Agent private key for auto-executing ready payrolls (optional)
# If not set, cron will only check but not execute
AGENT_PRIVATE_KEY=0x...
