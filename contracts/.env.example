# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
ARC_RPC_URL=https://rpc.arc.io

# Block Explorer API Keys (for verification)
ETHERSCAN_API_KEY=your_etherscan_api_key
ARC_API_KEY=your_arc_explorer_api_key

# Optional: Circle Gateway address on Sepolia
CIRCLE_GATEWAY=0x0000000000000000000000000000000000000000

# Optional: USDC address on Arc (defaults to native USDC)
ARC_USDC_ADDRESS=0x79A02482A880bCE3F13e09Da970dC34db4CD24d1
